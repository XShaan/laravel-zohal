{
    "name": "xshaan/laravel-zohal",
    "description": "Laravel SDK for Zohal.io inquiry APIs (identity, banking, and service lookups).",
    "version": "1.1.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "zohal",
        "shahkar",
        "inquiry",
        "iran",
        "kyc",
        "iban",
        "national-code"
    ],
    "authors": [
        {
            "name": "XShaan",
            "email": "shayan.sakha@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "XShaan\\Zohal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XShaan\\Zohal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XShaan\\Zohal\\ZohalServiceProvider"
            ],
            "aliases": {
                "Zohal": "XShaan\\Zohal\\Facades\\Zohal"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
